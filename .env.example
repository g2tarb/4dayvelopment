# ─────────────────────────────────────────────────────────────
# 4DAYVELOPMENT — Variables d'environnement
# Copier ce fichier en `.env` puis remplir les valeurs réelles.
# Le `.env` n'est PAS versionné (voir .gitignore).
# ─────────────────────────────────────────────────────────────

# Environnement : "development" (défaut) ou "production"
NODE_ENV=development

# Port d'écoute du serveur (défaut : 3000)
PORT=3000

# ── Obligatoires ─────────────────────────────────────────────
# Origine autorisée pour le CORS (URL publique du site)
ALLOWED_ORIGIN=https://4dayvelopment.fr

# Compte SMTP pour l'envoi des emails (Nodemailer)
MAIL_USER=ton-email@gmail.com
MAIL_PASS=mot-de-passe-application

# ── Webhook N8n (CRM) ────────────────────────────────────────
# URL de PRODUCTION du node Webhook (workflow ACTIVÉ).
# ⚠ Ne PAS utiliser l'URL de test (/webhook-test/...), elle n'écoute
#   qu'une fois après un clic sur "Listen for test event".
# Si cette variable est absente, les leads sont juste sauvegardés
# dans data/leads.json et ne sont PAS transmis à N8n.
N8N_WEBHOOK_URL=https://n8n.srv1263084.hstgr.cloud/webhook/xxxxxxxx-xxxx-xxxx

# ── Optionnels ───────────────────────────────────────────────
# Destinataire des emails de contact (défaut : MAIL_USER)
MAIL_TO=

# Serveur SMTP (défaut : smtp.gmail.com:587)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587

# Token partagé pour la publication d'articles de blog depuis N8n
# (route POST /api/blog/publish, en-tête x-blog-token)
N8N_BLOG_TOKEN=
